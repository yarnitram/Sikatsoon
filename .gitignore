# Dependencies
/node_modules
/.pnpm-store

# Next.js build output
/.next/
/out/

# Storage & Local SQLite database
/storage/downloads/*
!/storage/downloads/.gitkeep
/storage/temp/*
!/storage/temp/.gitkeep
/storage/*.db
/storage/*.db-journal
/storage/*.db-wal
/storage/*.db-shm

# Environment variables & secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Files
.DS_Store
Thumbs.db
*.tsbuildinfo
